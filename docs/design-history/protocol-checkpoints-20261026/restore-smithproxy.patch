+            feed(c, Side::RIGHT, frame(0, 0, 1, "hello"));
+            EXPECT_EQ(state(c).streams.at(1).response_flow_window_, 99995);
+            EXPECT_EQ(state(c).streams.at(3).response_flow_window_, 100000);
