+        using Restore = std::function<void(EngineCtx&, RewindFlow const&)>;
+
+        ProtocolCheckpoint(EngineCtx const* owner, Restore restore)
+            : owner_(owner), restore_(std::move(restore)) {}
+
+        EngineCtx const* owner_;
