+            EXPECT_EQ(state(c).streams.at(1).request_body_bytes_, 3U);
+            EXPECT_EQ(state(c).client_connection_window, 65529);
+        }},
+        {"EndStream", [](auto& c) {
+            feed(c, Side::LEFT, frame(0, 1, 1, "done"));
+        }, [](auto& c) {
