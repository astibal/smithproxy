+            feed(c, Side::LEFT, frame(0, 0, 1, "hello").substr(0, 11));
+        }, [](auto& c) {
+            feed(c, Side::LEFT, frame(0, 0, 1, "hello").substr(11));
+            EXPECT_EQ(state(c).streams.at(1).request_body_bytes_, 5U);
