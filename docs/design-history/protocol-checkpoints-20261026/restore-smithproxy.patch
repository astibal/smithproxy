+            EXPECT_EQ(state(c).left_settings_awaiting_ack, 1U);
+            feed(c, Side::RIGHT, frame(4, 1, 0));
+            EXPECT_EQ(state(c).left_settings_awaiting_ack, 0U);
+        }},
+        {"DataBody", [](auto& c) {
