preamble
name "Smithproxy full-duplex tiny-buffer torture"
description "Two marked streams cross transparent Smithproxy with constrained socket buffers"
owner "smithproxy"
timeout 45s
begin using tcp
server at "netns:sxr-origin"
client at "netns:sxr-client"
server listen "198.18.20.2:18080"
client connect "198.18.20.2:18080"
server set-sndbuf 4KiB
server set-rcvbuf 4KiB
client set-sndbuf 4KiB
client set-rcvbuf 4KiB
server drain 2MiB stamp-every 4KiB
client drain 2MiB stamp-every 4KiB
server transmit 2MiB stamp-every 4KiB chunk 113B
client transmit 2MiB stamp-every 4KiB chunk 127B
server await-tx
client await-tx
server half-close-write
client half-close-write
server await-rx
client await-rx
server receive-eot
client receive-eot
server close
client close
end
outcome pass
when server.rx.bytes == 2MiB
and server.rx.integrity == valid
and client.rx.bytes == 2MiB
and client.rx.integrity == valid
and server.rx.eot == received
and client.rx.eot == received
describe "Smithproxy preserved both streams and propagated crossed FINs."
outcome fail "Smithproxy lost, duplicated, reordered or truncated full-duplex traffic."
outcome timeout "Smithproxy hung under full-duplex backpressure or crossed FINs."
end
