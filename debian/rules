#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DSMITHPROXY_ENABLE_CPACK=OFF

# Installing a network interception daemon must not immediately alter the
# host network. Template instances are activated explicitly by the admin.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_fixperms:
	dh_fixperms --exclude=users.key --exclude=-key.pem
