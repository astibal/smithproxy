#!/usr/bin/env sh

ARCHIVE="${SMITHPROXY_CFTAR:-/etc/smithproxy/smithproxy.cftar}"
CFTAR="${SMITHPROXY_CFTAR_CMD:-smithproxy-cftar}"
RESOURCE="pki/trust/ca-bundle.pem"
FILE_URL="https://curl.se/ca/cacert.pem"
FILE_PATH="$(mktemp)" || exit 1
trap 'rm -f "${FILE_PATH}"' EXIT HUP INT TERM

wget "${FILE_URL}" -O "${FILE_PATH}"

if [ $? -ne 0 ]; then
    echo "   !!! Sorry, something went wrong..."
else
    "${CFTAR}" resource import "${ARCHIVE}" "${RESOURCE}" "${FILE_PATH}" || exit 1
    echo
    echo "       => resource saved as ${RESOURCE}"
    echo "   !!! Smithproxy must be restarted to activate the new trust bundle."
    echo
fi


