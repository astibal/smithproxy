[submodule "socle"]
	path = socle
	url = git@github.com:astibal/socle.git
	branch = master
	update = checkout
[submodule "src/ext/lmhpp"]
	path = src/ext/lmhpp
	url = ../lmhpp
[submodule "src/ext/ngtcp2"]
	path = src/ext/ngtcp2
	url = https://github.com/ngtcp2/ngtcp2.git
[submodule "src/ext/libsxcli2"]
	path = src/ext/libsxcli2
	url = https://github.com/astibal/libsxcli2.git
[submodule "src/ext/libsxcftar"]
	path = src/ext/libsxcftar
	url = https://github.com/astibal/libsxcftar.git
