[Unit]
Description=Smithproxy Core - tenant %i
Requires=sx-network@%i.service
After=network.target remote-fs.target nss-lookup.target sx-network@%i.service

[Service]
#User=_sxy
Type=simple
PIDFile=/var/run/smithproxy.%i.pid
ExecStart=/usr/bin/smithproxy --tenant-name %i
Restart=always
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
